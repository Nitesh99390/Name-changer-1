# =====================================================================
#  Advanced Novel Translator Bot — Environment Variables
# =====================================================================
#  Local testing: copy this file to ".env" and fill in real values.
#  Render / Koyeb / Heroku: add these in the dashboard's
#  "Environment" / "Config Vars" section (DON'T upload .env).
# =====================================================================

# --- REQUIRED --------------------------------------------------------
# Get API_ID + API_HASH from https://my.telegram.org  ->  API development tools
API_ID=1234567
API_HASH=your_api_hash_here

# Get BOT_TOKEN from @BotFather on Telegram
BOT_TOKEN=123456:ABC-DEF_your_bot_token_here

# --- OPTIONAL --------------------------------------------------------
# Your own Telegram numeric user id (for /stats & /broadcast).
# Find it via @userinfobot. Leave 0 to disable admin-only commands.
ADMIN_ID=0

# Port for the health-check web server (Render/Koyeb set this automatically).
PORT=10000
PYTHONUNBUFFERED=1

# Max upload size (MB) the bot will accept.
MAX_FILE_MB=50

# Per-user rate limit (seconds between file submissions).
RATE_LIMIT_S=15


# Startup retries for transient network/server errors (clamped to 1..10).
CONNECT_RETRIES=5

# Per-attempt startup deadline. A timeout exits for a clean supervisor restart.
CONNECT_TIMEOUT_S=60

# Maximum time spent closing Telegram during retry/shutdown.
SHUTDOWN_TIMEOUT_S=15

# While starting, log "Still starting: stage=..." every N seconds (min 5) so a
# hung stage is visible in platform logs instead of a silent port-scan timeout.
STARTUP_HEARTBEAT_S=20
